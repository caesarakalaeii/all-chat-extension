# Install devDependencies even when NODE_ENV=production is set in the ambient
# environment. The test and type-check toolchain (vitest, typescript, the
# webpack stack) lives in devDependencies, so `npm ci` must not omit them or
# `npm run test:unit` and `npm run type-check` fail with "command not found".
#
# This must be `omit=` (an explicit empty list) and NOT `include[]=dev` or
# `production=false`: npm applies `include` after `omit`, so both of those
# spellings would override an explicit `--omit=dev` given on the command line
# and silently break any `npm audit --omit=dev` job. An empty `omit` cancels
# only the value NODE_ENV=production implies, while `--omit=dev` on the CLI
# still wins.
#
# npm prints "invalid config omit=" for the empty value. The warning is
# cosmetic and the resolved value is correct (`npm config get omit`); the
# alternatives above are silent but functionally wrong here.
omit=

# Some CI/dev containers use an Alpine userland (so /usr/bin/ldd is the musl
# shim) while running a glibc-linked Node, e.g. Node installed from nix. npm's
# libc detection trusts that shim and installs @rollup/rollup-linux-x64-musl,
# which the glibc Node then cannot dlopen -- vitest dies at startup with
# "Cannot find module @rollup/rollup-linux-x64-gnu ... Cannot find native
# binding" before a single test runs. Pinning glibc makes npm fetch the
# bindings that actually match the Node binary.
#
# Both variants are already in package-lock.json as optional deps, so this
# changes which one is selected, not what is resolvable. A genuine musl host
# is unaffected in production: the extension ships as a static bundle built by
# webpack and has no install step at runtime.
#
# Mirrors all-chat: frontend/.npmrc, which documents the same two hazards.
libc=glibc
