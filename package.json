{
  "name": "allchat-extension",
  "version": "1.7.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Browser extension to replace native platform chat with All-Chat",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "package": "npm run build && cd dist && zip -r ../allchat-extension.zip .",
    "test": "npx playwright test --grep-invert @agent",
    "test:agent": "npx playwright test --grep @agent",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.0",
    "mini-css-extract-plugin": "^2.10.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.2",
    "@types/node": "^25.9.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.62.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^9.39.5",
    "html-webpack-plugin": "^5.6.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.20",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7",
    "webpack": "^5.108.4",
    "webpack-cli": "^5.1.4",
    "ws": "^8.21.1"
  }
}
